{
  "info": {
    "name": "Ilonggo Speak Team API",
    "_postman_id": "8b2c3f5a-1111-4444-9999-abcdef123456",
    "description": "Team-only Ilonggo Speak corpus, review, dictionary, and dataset API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api" },
    { "key": "teamToken", "value": "" }
  ],
  "item": [
    {
      "name": "Team Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"contributor\",\n  \"password\": \"change-me\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "List Corpus",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{teamToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/sentences?page=1&limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["sentences"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "50" }
          ]
        }
      }
    },
    {
      "name": "Create Translation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{teamToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"english\": \"Where are you going?\",\n  \"hiligaynon\": \"Diin ka makadto?\",\n  \"sentiment\": 1,\n  \"intent\": \"location_question\",\n  \"domain\": \"daily_life\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sentences",
          "host": ["{{baseUrl}}"],
          "path": ["sentences"]
        }
      }
    },
    {
      "name": "Review Translation",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{teamToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"approved\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sentences/:id/status",
          "host": ["{{baseUrl}}"],
          "path": ["sentences", ":id", "status"]
        }
      }
    },
    {
      "name": "Dictionary Lookup",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{teamToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/engine/dictionary?q=gid&language=hil",
          "host": ["{{baseUrl}}"],
          "path": ["engine", "dictionary"],
          "query": [
            { "key": "q", "value": "gid" },
            { "key": "language", "value": "hil" }
          ]
        }
      }
    },
    {
      "name": "Generate Dataset",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{teamToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Hiligaynon General Translation\",\n  \"version\": \"1.0\",\n  \"maxItems\": 10000,\n  \"excludeSarcastic\": true,\n  \"requireProvenance\": false,\n  \"trainPercent\": 80,\n  \"validationPercent\": 10,\n  \"testPercent\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/engine/datasets/generate",
          "host": ["{{baseUrl}}"],
          "path": ["engine", "datasets", "generate"]
        }
      }
    }
  ]
}
